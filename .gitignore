# Car assets (not needed in git, use Cloudinary)
Car Body Types/
Car logos/

# Prisma
prisma/migrations/
!prisma/schema.prisma
!prisma/seed.js

# The database itself NEVER goes in git — it holds real customer names and
# phone numbers, and git is not a backup (use `npm run db:backup`, or the
# provider's backups on Neon).
prisma/*.db
prisma/*.db-wal
prisma/*.db-shm
prisma/dev.db.backup-*
*.sqlite
*.sqlite3

# Pre-change working copies of source trees
**/.backup-pre-*

# Full-database exports (npm run data:export) — these carry real customer
# names and phone numbers. Used to migrate data to Neon; never commit them.
data-export*.json

# Vercel
.vercel
.vercel/

# TypeScript
*.tsbuildinfo

# Misc
.DS_Store
*.pem
