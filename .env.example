# GaliMotors — server environment
# Copy to .env and fill in. NEVER commit the real .env.
# Generate every secret below with:  openssl rand -base64 48

# ── Database ──────────────────────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (Neon Postgres) — use the POOLED connection string, or serverless
# functions will exhaust Neon's connection limit:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"

# ── JWT secrets ───────────────────────────────────────────────────────────
# REQUIRED in production — the server deliberately refuses to boot without
# them. Admin and customer tokens use separate secrets so a customer token can
# never be replayed as an admin one. Use long random values, never guessable.
JWT_SECRET_ADMIN=""
JWT_REFRESH_SECRET_ADMIN=""
JWT_SECRET_CUSTOMER=""
JWT_REFRESH_SECRET_CUSTOMER=""

# Legacy fallbacks (older code paths read these when the specific ones are unset)
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Signing key for CSRF tokens
CSRF_SECRET=""

# ── URLs ──────────────────────────────────────────────────────────────────
# Public customer site — used for sitemap links and the Meta catalog feed.
# Must be the real domain in production, or your Facebook ads link to localhost.
PUBLIC_SITE_URL="http://localhost:5174"
FRONTEND_URL="http://localhost:5174"

# Browser origins allowed to call the API, comma-separated. Leave unset in
# development (localhost is allowed automatically).
# CORS_ORIGINS="https://galimotors.mw,https://www.galimotors.mw"

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ── Business contact ──────────────────────────────────────────────────────
# Fallbacks only — the admin Settings screen is the source of truth once set.
ADMIN_WHATSAPP=""
ADMIN_PHONE=""

# ── Cloudinary (image storage) ────────────────────────────────────────────
# The only image store — uploads fail with a clear 503 if these are unset.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Twilio (automated WhatsApp/SMS) — OPTIONAL, not currently installed ────
# Setting these alone is NOT enough: also `npm install twilio`, or sending
# throws. Until then the app reports honestly that nothing was sent, and
# admins message customers through the wa.me links in the panel.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""   # Format: +14155238886
TWILIO_PHONE_NUMBER=""      # Format: +14155238886

# ── SMTP (email notifications) — OPTIONAL, requires `npm install nodemailer`
SMTP_HOST=""                # e.g. smtp.gmail.com
SMTP_PORT="587"
SMTP_SECURE="false"         # true for port 465, false otherwise
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""                # Sender address (defaults to SMTP_USER)
